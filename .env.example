# Telegram Bot Yapılandırması
# @BotFather üzerinden aldığınız bot token:
TELEGRAM_BOT_TOKEN=your_bot_token_here

# @userinfobot veya @getmyid_bot üzerinden aldığınız kendi Telegram Chat ID'niz (veya kanal kullanıcı adı @kanal_adi)
TELEGRAM_CHAT_ID=your_chat_id_here

# Supabase Bulut Veritabanı (7/24 Kesintisiz & GitHub Actions İçin Ücretsiz)
# Supabase Dashboard -> Project Settings -> API kısmından alınır:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Otomatik tarama aralığı (Dakika cinsinden - Acil salgınları hızlı yakalamak için 20 dk idealdir; yeni haber yoksa sessizdir)
CHECK_INTERVAL_MINUTES=20

# Her taramada en fazla kaç haber gönderilsin (Benzersiz olan tüm haberlerin iletilmesi için güvenlik üst sınırı)
MAX_ITEMS_PER_CHECK=10

# Kaynak Açma/Kapama Seçenekleri (True/False)
ENABLE_GOV_NEWS=True       # Tarım Bakanlığı ve TVHB
ENABLE_WOAH_NEWS=True      # Dünya Hayvan Sağlığı Örgütü (Salgınlar)
ENABLE_GOOGLE_NEWS=True    # Google News Türkçe Veteriner Gündemi
ENABLE_PUBMED=True         # PubMed Akademik Araştırmalar
ENABLE_REDDIT=True         # Reddit Mesleki Tartışmalar
ENABLE_LINKEDIN=True       # LinkedIn Sektörel Paylaşımlar
